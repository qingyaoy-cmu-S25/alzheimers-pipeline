# Example backend/.env for local development
# Do NOT commit your real API keys. Copy this file to backend/.env and fill values.

# For Azure OpenAI
OPENAI_API_KEY=<your-azure-openai-key>
OPENAI_BASE_URL=https://<your-resource-name>.openai.azure.com/openai/v1
OPENAI_DEPLOYMENT=<your-deployment-name>

# For public OpenAI (alternatively)
# OPENAI_API_KEY=<your-openai-api-key>
# OPENAI_MODEL=gpt-4o

# Use mock mode for frontend development without calling OpenAI
# OPENAI_MOCK=true
